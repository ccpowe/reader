# Public Docker deployment settings. Secrets live under .docker/inputs and
# .docker/secrets; never put them in this file.
READER_API_BIND_HOST=127.0.0.1
READER_API_PORT=8000
APP_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
APP_CORS_ORIGINS=[]
APP_LOG_LEVEL=INFO

APP_TRANSLATION_DEFAULT_ENGINE_ID=deepseek-v4-flash
APP_DEEPSEEK_API_BASE=https://api.deepseek.com
APP_DEEPSEEK_MODEL=deepseek-flash
APP_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
APP_OPENROUTER_MODEL=minimax/minimax-m3
# Codex login is imported into its private Docker volume, never this file.
APP_CODEX_SUBSCRIPTION_MODEL=gpt-6-luna
APP_CODEX_SUBSCRIPTION_REQUEST_TIMEOUT_SECONDS=60
APP_WEB_RULE_AGENT_ENGINE_ID=disabled
APP_YOUTUBE_DAILY_QUOTA_SOFT_LIMIT=8000

# Durable translation budgets and bounded rule-authoring limits.
APP_TRANSLATION_QUOTA_REQUESTS_PER_MINUTE=30
APP_TRANSLATION_QUOTA_USER_MISS_CHARS_PER_MINUTE=120000
APP_TRANSLATION_QUOTA_GLOBAL_MISS_CHARS_PER_MINUTE=500000
APP_WEB_RULE_AGENT_MAX_OUTPUT_TOKENS=4096
APP_WEB_RULE_AGENT_MODEL_TIMEOUT_SECONDS=60
APP_WEB_RULE_AGENT_VALIDATE_TIMEOUT_SECONDS=180
APP_WEB_RULE_AGENT_MAX_TOOL_RESULT_BYTES=20480
APP_WEB_RULE_AGENT_MAX_DIAGNOSTIC_BYTES=262144
