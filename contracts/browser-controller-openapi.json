    "/v1/tasks/{task_id}/renew": {
      "post": {
        "operationId": "renew_task_v1_tasks__task_id__renew_post",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Reader-Task-Capability",
