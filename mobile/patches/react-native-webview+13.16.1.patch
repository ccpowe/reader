+    @Override
+    public WindowInsets onApplyWindowInsets(WindowInsets insets) {
+        // React Native owns the app's edge-to-edge layout. Forwarding the same system-bar and
+        // display-cutout insets into web content adds a second safe area and shifts fullscreen
+        // players away from the physical center of the display. Keep IME and future inset updates
+        // intact, but zero the native inset types that have already been handled by the app.
+        final int webContentInsetTypes = WindowInsetsCompat.Type.systemBars()
+                | WindowInsetsCompat.Type.displayCutout();
+        final WindowInsetsCompat adjustedInsets = new WindowInsetsCompat.Builder(
+                WindowInsetsCompat.toWindowInsetsCompat(insets)
+        )
+                .setInsets(webContentInsetTypes, Insets.NONE)
+                .build();
+        final WindowInsets adjustedPlatformInsets = adjustedInsets.toWindowInsets();
+        return super.onApplyWindowInsets(adjustedPlatformInsets != null ? adjustedPlatformInsets : insets);
+    }
