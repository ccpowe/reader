{
  "name": "mobile",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mozilla/readability": "0.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tabler/icons-react-native": "3.51.0",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "dompurify": "3.4.15",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-network": "58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.72.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "uniwind": "1.13.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@storybook/react-native": "10.7.1",
    "@storybook/react-native-ui-lite": "10.7.1",
    "@types/node": "^24.13.3",
    "@types/react": "~19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "storybook": "10.6.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "generate:translation-runtime": "node ./scripts/generate-translation-runtime-sources.mjs",
    "generate:api-types": "node ./scripts/generate-api-types.mjs",
    "preandroid": "pnpm run generate:translation-runtime",
    "preios": "pnpm run generate:translation-runtime",
    "prestart": "pnpm run generate:translation-runtime",
    "preweb": "pnpm run generate:translation-runtime",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "storybook": "STORYBOOK_ENABLED=true STORYBOOK_DISABLE_TELEMETRY=1 expo start --go --max-workers 1",
    "test": "pnpm run test:api-contract && pnpm run typecheck && pnpm run lint && pnpm run test:unit && pnpm run test:translation-runtime",
    "test:api-contract": "node ./scripts/generate-api-types.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "pnpm run lint -- --fix",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts'",
    "test:translation-runtime": "node ./scripts/generate-translation-runtime-sources.mjs --check && node ./scripts/test-web-translation-commit-queue.mjs && node ./scripts/test-web-translation-rules.mjs && node ./scripts/test-translation-runtime-serialization.mjs && pnpm run test:web-translation-browser",
    "test:web-translation-browser": "playwright test --config playwright.web-translation.config.mjs",
    "check:story-alignment": "node scripts/check-story-alignment.mjs"
  },
  "private": true
}
