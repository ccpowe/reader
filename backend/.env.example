# Configuration template for running the backend directly (local development or
# a systemd deployment). Copy to backend/.env and never commit .env. Docker
# deployments use ../.env.docker.example and file secrets instead.
#
# Every APP_* name matches a field of src/reader/core/settings.py; values left
# commented out use the default shown there. Before production:
# - set APP_ENVIRONMENT=production;
# - replace every change-me / replace_me value with independent random values;
# - set APP_PUBLIC_API_BASE_URL to the externally reachable HTTPS base URL;
# - set APP_CORS_ORIGINS to the real browser origins, or [] when none are used;
# - configure the translation engine you use before starting reader-worker.
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:8081", "http://localhost:19006"]

# Stable public identity for the discovery document; one value per deployment,
# unchanged across restarts.
APP_SERVER_ID=reader-local
# Optional behind a trusted reverse proxy: the externally reachable base URL,
# with any path prefix and no trailing slash.
# APP_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Connection token, entered once in the app's connection screen.
APP_SERVER_ACCESS_TOKEN=reader-local-connection-token-change-me
# Independent signing secret, at least 32 characters; never the connection token.
APP_AUTH_JWT_SECRET=reader-local-jwt-signing-secret-change-me-32
# APP_AUTH_ACCESS_TOKEN_SECONDS=900
# APP_AUTH_REFRESH_TOKEN_DAYS=30
# APP_AUTH_PASSWORD_ATTEMPTS_PER_MINUTE=20
# APP_AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=300

# PostgreSQL. POSTGRES_* only feed compose.postgres.yml (the local database
# container); the backend reads APP_DATABASE_URL. Standard postgresql:// works.
POSTGRES_DB=reader
POSTGRES_USER=reader
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432
APP_DATABASE_URL=postgresql://reader:replace_me@127.0.0.1:5432/reader
APP_DATABASE_SSL=false
# APP_DATABASE_POOL_SIZE=5
# APP_DATABASE_POOL_TIMEOUT_SECONDS=5
# APP_READINESS_TIMEOUT_SECONDS=2

# Source scanning (reader-worker).
# APP_WORKER_POLL_INTERVAL_SECONDS=60
# APP_SCAN_MAX_ITEMS=120
# APP_SCAN_INITIAL_ITEMS=10
# APP_SCAN_TIMEOUT_SECONDS=120
# APP_SCAN_LEASE_SECONDS=180
# APP_SCAN_CONCURRENCY=4
# APP_ARTICLES_KEPT_PER_SOURCE=500
# Only for a local Mihomo/Clash fake-IP proxy. Never enable in production.
APP_TRUST_PROXY_FAKE_IP=false

# Boards.
# APP_BOARD_MANUAL_REFRESH_COOLDOWN_SECONDS=60
# APP_BOARD_SNAPSHOT_KEEP_DAYS=7
# APP_BOARD_ITEMS=50
# Optional Product Hunt API token for its daily board; omit to hide that board.
# APP_PRODUCT_HUNT_TOKEN=replace_me

# Translation. Model credentials stay in the backend, never in the app.
# Engines: deepseek-v4-flash, openrouter-minimax-m3, codex-subscription, disabled.
APP_TRANSLATION_DEFAULT_ENGINE_ID=deepseek-v4-flash
APP_TRANSLATION_DEFAULT_TARGET_LOCALE=zh-CN
# Characters sent to models by the whole deployment (cache hits are free); 0 = no limit.
# APP_TRANSLATION_CHARS_PER_MINUTE=500000
# APP_TRANSLATION_CHARS_PER_DAY=2000000
# APP_DEEPSEEK_API_KEY=replace_me
# APP_DEEPSEEK_MODEL=deepseek-flash
# APP_OPENROUTER_API_KEY=replace_me
# APP_OPENROUTER_MODEL=minimax/minimax-m3
# Codex ChatGPT subscription (translation only). The login belongs to Reader,
# not the Codex CLI: import a dedicated one with `reader-admin codex-auth import`.
# API and worker share this writable private file.
# APP_CODEX_SUBSCRIPTION_AUTH_FILE=/absolute/private/reader-codex/auth.json
# APP_CODEX_SUBSCRIPTION_MODEL=gpt-6-luna

# Optional X collection through the companion Scweet service.
# APP_SCWEET_SERVICE_URL=http://127.0.0.1:8090
# APP_SCWEET_SERVICE_TOKEN=replace_with_the_same_token_as_services_env

# Optional YouTube Data API key; without it channels use the Atom feed.
# APP_YOUTUBE_DATA_API_KEY=replace_me
# APP_YOUTUBE_DAILY_QUOTA=8000
