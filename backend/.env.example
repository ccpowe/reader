# Single configuration template for local development and production.
# Copy to backend/.env and never commit .env.
#
# Local development can keep APP_ENVIRONMENT=development, the localhost CORS
# origins, reader-local identifiers, and loopback database settings below.
# Before production deployment:
# - set APP_ENVIRONMENT=production;
# - replace every change-me / replace_me credential with independent random values;
# - set APP_PUBLIC_API_BASE_URL to the externally reachable HTTPS base URL;
# - replace APP_CORS_ORIGINS with the real browser origins, or [] when none are used;
# - configure at least one translation provider key before starting reader-worker;
# - uncomment only the optional X, YouTube, Web Agent, or browser settings in use.
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:8081", "http://localhost:19006"]

# Stable public identity for the Reader discovery document. Choose one value
# per logical deployment and keep it unchanged across restarts.
APP_SERVER_ID=reader-local
# Optional when the API is mounted behind a trusted reverse proxy. Include the
# externally reachable path prefix and omit a trailing slash. If unset, the
# API derives the base from its trusted ASGI request URL/root_path.
# APP_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Shared connection token. Set the same value in the app connection screen.
# These example defaults are for local development; actual .env uses random values.
APP_SERVER_ACCESS_TOKEN=reader-local-connection-token-change-me
# Independent signing secret, at least 32 characters; never reuse the connection token.
APP_AUTH_JWT_SECRET=reader-local-jwt-signing-secret-change-me-32
APP_AUTH_ACCESS_TOKEN_SECONDS=900
APP_AUTH_REFRESH_TOKEN_DAYS=30
APP_AUTH_PASSWORD_ATTEMPTS_PER_MINUTE=20

# Self-managed PostgreSQL. Standard postgresql:// is accepted.
POSTGRES_DB=reader
POSTGRES_USER=reader
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432
APP_DATABASE_URL=postgresql://reader:replace_me@127.0.0.1:5432/reader

# X collection is explicit: Scweet is the default; use "apify" only when
# deliberately selecting the compatibility provider. There is no auto-failover.
APP_X_PROVIDER=scweet
# The normal server deployment runs reader-scweet.service on the same host when enabled.
# Docker-to-Docker deployments use http://scweet:8090 on reader-internal instead.
# APP_SCWEET_SERVICE_URL=http://127.0.0.1:8090
# APP_SCWEET_SERVICE_TOKEN=replace_with_the_same_token_as_services_env
# APP_APIFY_TOKEN=replace_me

# Official YouTube Data API key. Atom remains a degraded fallback.
# APP_YOUTUBE_DATA_API_KEY=replace_me
APP_YOUTUBE_DAILY_QUOTA_SOFT_LIMIT=8000
APP_DATABASE_SSL=false
# Hosted database intermediaries may drop otherwise-idle pooled connections.
# Disable only when you control that lifecycle and prefer to avoid pre-ping.
APP_DATABASE_POOL_PRE_PING=true
# Keep the combined API + worker + listener connection budget bounded.
# Overflow is disabled so bursts wait locally.
APP_DATABASE_POOL_SIZE=3
APP_DATABASE_POOL_MAX_OVERFLOW=0
# Fail a saturated local checkout quickly; do not hold HTTP requests for the
# SQLAlchemy default 30 seconds.
APP_DATABASE_POOL_TIMEOUT_SECONDS=5
APP_AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=300
APP_READINESS_STARTUP_TIMEOUT_SECONDS=30
APP_READINESS_TIMEOUT_SECONDS=2
APP_READINESS_CACHE_SECONDS=5

# Only for a local Mihomo/Clash fake-IP proxy. Never enable in production.
APP_TRUST_PROXY_FAKE_IP=false

# The dedicated worker scans for due sources at this interval.
APP_WORKER_POLL_INTERVAL_SECONDS=60

# Dynamic Web exploration, rule execution and periodic scans share Lightpanda.
# Linux, bubblewrap and a pinned 0.4.0 executable are required only for dynamic
# pages. Static HTTP needs no browser. Missing support never starts Chromium.
APP_INGESTION_BROWSER_ENGINE=lightpanda
# APP_INGESTION_LIGHTPANDA_EXECUTABLE_PATH=/opt/reader/lightpanda-0.4.0

# Automatic Web rule authoring runs inside reader-worker. Select a shared managed
# engine explicitly: deepseek-v4-flash / openrouter-minimax-m3 / disabled.
# Provider credentials and actual model names are shared with translation;
# users' translation preferences do not choose the rule authoring engine.
APP_WEB_RULE_AGENT_ENGINE_ID=disabled
# Absolute path to agent-browser 0.37.1 native binary (not npm launcher). Required for exploration.
# APP_WEB_RULE_AGENT_CLI_EXECUTABLE_PATH=/opt/reader/agent-browser-0.37.1/node_modules/agent-browser/bin/agent-browser-linux-x64
APP_WEB_RULE_AGENT_POLL_SECONDS=10
APP_WEB_RULE_AGENT_MODEL_TIMEOUT_SECONDS=60
APP_WEB_RULE_AGENT_MAX_OUTPUT_TOKENS=4096
# Two cumulative task quotas: model requests and input/output tokens (including cache hits).
# Check recorded usage before starting the next request; a final response can cross it.
# Missing usage is charged conservatively; leases and I/O bounds below protect execution.
APP_WEB_RULE_AGENT_MAX_TOTAL_TOKENS=3000000
APP_WEB_RULE_AGENT_MAX_MODEL_CALLS=80
APP_WEB_RULE_AGENT_MAX_TOOL_RESULT_BYTES=20480
APP_WEB_RULE_AGENT_MAX_DIAGNOSTIC_BYTES=262144
APP_WEB_RULE_AGENT_INSPECT_TIMEOUT_SECONDS=60
APP_WEB_RULE_AGENT_VALIDATE_TIMEOUT_SECONDS=180
APP_WEB_RULE_AGENT_LEASE_SECONDS=120
APP_WEB_RULE_AGENT_HEARTBEAT_SECONDS=15
APP_WEB_RULE_AGENT_VALIDATION_TTL_SECONDS=300

# Backend-only ingestion safety policy. These values are not subscription fields.
APP_INGESTION_MAX_ITEMS_PER_SYNC=40
APP_INGESTION_RAW_ITEMS_PER_SYNC=120
APP_INGESTION_MAX_PAGES_PER_SYNC=5
APP_INGESTION_MAX_RESPONSE_BYTES=5242880
APP_INGESTION_DNS_TIMEOUT_SECONDS=3
APP_INGESTION_CONNECT_ATTEMPT_TIMEOUT_SECONDS=1.5
APP_INGESTION_SOURCE_TIMEOUT_SECONDS=120
APP_INGESTION_SOURCE_CONCURRENCY=4
APP_INGESTION_CANDIDATE_BATCH_SIZE=50
APP_INGESTION_SCAN_LEASE_SECONDS=180
APP_INGESTION_CANDIDATE_LEASE_SECONDS=180

# Shared ranking refreshes use short DB leases and bounded manual refreshes.
APP_RANKING_REFRESH_LEASE_SECONDS=240
APP_RANKING_MANUAL_REFRESH_COOLDOWN_SECONDS=60
APP_RANKING_SNAPSHOT_INACTIVE_TTL_DAYS=7
APP_REDDIT_SUBSCRIPTION_LIMIT_PER_USER=20
APP_RANKING_PROVIDER_REFRESHES_PER_MINUTE=30
APP_REDDIT_RANKING_REFRESHES_PER_MINUTE=1
# Ranking refreshes use at most four independent provider sessions per cycle
# and fail the cycle after a total 120-second deadline by default.
APP_RANKING_WORKER_CONCURRENCY=4
APP_RANKING_WORKER_CYCLE_TIMEOUT_SECONDS=120

# Translation credentials stay in the backend only; never put them in the Expo app.
APP_TRANSLATION_DEFAULT_ENGINE_ID=deepseek-v4-flash
APP_TRANSLATION_DEFAULT_TARGET_LOCALE=zh-CN
APP_TRANSLATION_PROMPT_VERSION=v2-caption-context
APP_TRANSLATION_BATCH_SIZE=50
APP_TRANSLATION_FOREGROUND_BATCH_SIZE=12
APP_TRANSLATION_BACKGROUND_BATCH_SIZE=24
APP_TRANSLATION_LEASE_SECONDS=120
APP_TRANSLATION_MAX_ATTEMPTS=8
APP_TRANSLATION_CONTEXT_CACHE_SECONDS=30
APP_TRANSLATION_INTERACTIVE_TIMEOUT_SECONDS=8
APP_TRANSLATION_INTERACTIVE_MAX_ITEMS_PER_BATCH=12
APP_TRANSLATION_INTERACTIVE_MAX_CHARS_PER_BATCH=5000
APP_TRANSLATION_INTERACTIVE_MAX_CONCURRENCY=2
# Realtime calls wait briefly for an independently owned shared provider task.
APP_TRANSLATION_REALTIME_WAIT_SECONDS=5
APP_TRANSLATION_REALTIME_MAX_CONCURRENCY=16
APP_TRANSLATION_IDLE_POLL_SECONDS=30
APP_TRANSLATION_LISTENER_FALLBACK_POLL_SECONDS=2
APP_TRANSLATION_CLEANUP_TIMEOUT_SECONDS=5
APP_TRANSLATION_PROVIDER_MAX_CONCURRENCY=4
APP_TRANSLATION_LLM_MAX_ITEMS_PER_REQUEST=24
APP_TRANSLATION_LLM_MAX_CHARS_PER_REQUEST=12000
# Fixed 60-second PostgreSQL translation budgets. User overrides are managed
# only by `reader-admin translation-quota`; there is no unlimited value.
APP_TRANSLATION_QUOTA_REQUESTS_PER_MINUTE=30
APP_TRANSLATION_QUOTA_USER_MISS_CHARS_PER_MINUTE=120000
APP_TRANSLATION_QUOTA_GLOBAL_MISS_CHARS_PER_MINUTE=500000
# APP_DEEPSEEK_API_KEY=replace_me
DEEPSEEK_MODEL=deepseek-flash
APP_DEEPSEEK_REQUEST_TIMEOUT_SECONDS=20
# APP_OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=minimax/minimax-m3
APP_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
APP_OPENROUTER_REQUEST_TIMEOUT_SECONDS=20
