# Copy to /etc/reader/scweet.env, chmod 600, and replace every placeholder.
# Never commit the copied file.
SCWEET_SERVICE_TOKEN=replace-with-a-long-random-token
SCWEET_COOKIES_FILE=/opt/reader/services/scweet/cookies.json
SCWEET_STATE_DB=/var/lib/reader-scweet/scweet_state.db
SCWEET_MANIFEST_TTL_SECONDS=86400
